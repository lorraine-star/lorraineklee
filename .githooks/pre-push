#!/bin/sh
# Refuses pushes that would delete or force-push the permanent branches
# (main, dev). See the "Permanent branches" section of AGENTS.md.
#
# Wired up automatically by "npm install": the package.json "prepare" script
# points core.hooksPath at .githooks. This is a local guardrail only; the
# GitHub-side branch ruleset is the real enforcement.

protected="refs/heads/main refs/heads/dev"
zero=0000000000000000000000000000000000000000

while read local_ref local_sha remote_ref remote_sha; do
	for ref in $protected; do
		if [ "$remote_ref" = "$ref" ]; then
			if [ "$local_sha" = "$zero" ]; then
				echo "pre-push: BLOCKED. This push would delete $remote_ref on the remote." >&2
				echo "pre-push: main and dev are permanent branches and must never be deleted." >&2
				exit 1
			fi
			# Only flag a force-push when the remote commit is known locally;
			# if it is not, a plain non-fast-forward push is rejected by the
			# server anyway.
			if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha" 2>/dev/null; then
				if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
					echo "pre-push: BLOCKED. This is a non-fast-forward (force) push to $remote_ref." >&2
					echo "pre-push: merge or rebase your work instead of rewriting $remote_ref." >&2
					exit 1
				fi
			fi
		fi
	done
done
exit 0
