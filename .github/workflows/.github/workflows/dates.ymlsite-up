name: site-updates

on:

  workflow_dispatch:
  
permissions:

  contents: write
  
jobs:

  apply:
  
    runs-on: ubuntu-latest
    
    steps:
    
      - uses: actions/checkout@v4
      
      - run: |
      
          echo "" | base64 -d > public/images/editorial/favicon.png
          
          echo "" | base64 -d > public/images/v1/favicon.png
          
          echo "" | base64 -d > public/favicon.ico
          
      - run: |
      
          python3 - << 'PYEOF'
          
          import io
          
          def patch(path, old, new):
          
              s = io.open(path, encoding='utf-8').read()
              
              assert old in s, path + ': pattern missing'
              
              assert s.count(old) == 1, path + ': pattern not unique'
              
              io.open(path, 'w', encoding='utf-8').write(s.replace(old, new, 1))
              
              print('patched', path)
              
          patch('astro.config.mjs', "filter: (page) => !page.includes('/keystatic'),", "filter: (page) => !page.includes('/keystatic') && !page.includes('/consulting'),")
          
          patch('src/components/Seo.astro', '  type?: string;', '  type?: string;\n  /** Set true to keep this page out of search engines. */\n  noindex?: boolean;')
          
          patch('src/components/Seo.astro', "  type = 'website',", "  type = 'website', noindex = false,")
          
          patch('src/components/Seo.astro', '<link rel="canonical" href={canonical} />', '<link rel="canonical" href={canonical} />\n\n{noindex && <meta name="robots" content="noindex" />}')
          
          patch('src/layouts/SpeakingLayout.astro', '  image?: string;', '  image?: string;\n  /** When true, render a robots noindex meta tag. */\n  noindex?: boolean;')
          
          patch('src/layouts/SpeakingLayout.astro', "const { title, description, activeId = 'home', image } = Astro.props;", "const { title, description, activeId = 'home', image, noindex = false } = Astro.props;")
          
          patch('src/layouts/SpeakingLayout.astro', '<Seo title={title} description={description} image={image} />', '<Seo title={title} description={description} image={image} noindex={noindex} />')
          
          patch('src/pages/consulting.astro', '\tactiveId="consulting"', '\tactiveId="consulting"\n\tnoindex={true}')
          
          PYEOF
          
      - run: |
      
          git config user.name lorraine-star
          
          git config user.email lorraine-star@users.noreply.github.com
          
          git add -A
          
          git commit -m "Swap favicon to medium-blue bug; noindex consulting page"
          
          git push
































