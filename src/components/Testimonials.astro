---
/**
 * Global "What clients say" testimonials section.
 *
 * Canonical markup for the testimonials carousel. Self-contained for data:
 * by default it reads from the shared testimonials collection (CLI-118),
 * filtered to `showOnHomepage`, so a page can drop in <Testimonials /> with
 * no props. Heading copy can be overridden per page, and a caller may pass
 * its own `testimonials` array (the book page does this for endorsement
 * logos that don't live in the shared collection).
 *
 * Styling: this section depends on the shared layout primitives (.grid12,
 * .eyebrow) and the .testimonials / .t-* rules in src/styles/v1/home.css.
 * The home page loads that stylesheet via HomeLayout. Any other page that
 * uses this component must also load src/styles/v1/home.css. The React
 * carousel imports its own chrome styles.
 *
 * This is a GLOBAL section. Coordinate edits via Linear so parallel
 * worktrees don't drift.
 */
import HomeTestimonialsCarousel from './HomeTestimonialsCarousel';
import { getTestimonials, toCarouselCard } from '../lib/testimonials';

type Testimonial = {
  quote: string;
  name: string;
  role: string;
  photo?: string;
  photoAlt?: string;
  initials: string;
  /** Optional company / book-cover logos (used by the book page endorsements). */
  logos?: { image: string; alt: string }[];
};

interface Props {
  eyebrow?: string;
  /** Heading markup; may contain inline HTML such as <em>. */
  titleHtml?: string;
  lead?: string;
  /** Override the testimonials shown; defaults to the shared `showOnHomepage` set. */
  testimonials?: Testimonial[];
  /** Optional compact proof strip, supplied only by the homepage. */
  repeatBookings?: { name: string; multiplier: string; logo?: string }[];
}

const {
  eyebrow = 'What clients say',
  titleHtml = 'Companies bring her back <em>for more.</em>',
  lead = "From Fortune 500 leadership programs to high-potential cohorts at fast-growth tech companies, Lorraine's frameworks travel.",
  testimonials: testimonialsProp,
  repeatBookings = [],
} = Astro.props;

let testimonials = testimonialsProp;
if (!testimonials) {
  // Homepage selections and their page-specific order are editable in the
  // shared collection without changing the Speaking or About placements.
  const shared = await getTestimonials({ placement: 'homepage' });
  testimonials = shared.map(toCarouselCard);
}
---

<section class="testimonials" data-global-section="testimonials">
  <div class="grid12">
    <div class="testimonials-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="testimonials-title" set:html={titleHtml}></h2>
      {lead && <p class="lead">{lead}</p>}
    </div>
    {repeatBookings.length > 0 && (
      <ul class="testimonials-rebookings" aria-label="Repeat bookings">
        {repeatBookings.map((client) => (
          <li>
            {client.logo ? (
              <img class="rebooking-logo" src={client.logo} alt={client.name} loading="lazy" width="80" height="20" />
            ) : (
              <strong>{client.name}</strong>
            )}
            <span>{client.multiplier} bookings</span>
          </li>
        ))}
      </ul>
    )}
    <HomeTestimonialsCarousel testimonials={testimonials} client:load />
  </div>
</section>

<style>
  .testimonials-rebookings {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    margin: -20px 0 32px;
    padding: 16px 0;
    list-style: none;
    border-block: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--ink-700);
  }
  .testimonials-rebookings li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .testimonials-rebookings strong { color: var(--ink-900); }
  /* The mark rather than the company's name in bold text: a logo is
     recognised at a glance, where a name has to be read. Kept small and
     desaturated so the strip stays a supporting line under the heading
     instead of competing with the Trusted By grid elsewhere. */
  .rebooking-logo {
    height: 18px;
    width: auto;
    max-width: 92px;
    object-fit: contain;
    opacity: 0.75;
    filter: grayscale(1);
  }
  .testimonials-rebookings li:nth-child(2) .rebooking-logo { height: 15px; }
</style>
