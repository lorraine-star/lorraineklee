---
/*
 * /from-invisible-to-influential-thank-you/ — funnel confirmation step.
 *
 * Recreates the original WP thank-you page that Kit redirects to after a
 * successful signup. Same minimal funnel chrome (CLI-42); copy lives in
 * Keystatic alongside the funnel page.
 */
import FunnelLayout from '../layouts/FunnelLayout.astro';
import { reader } from '../lib/keystatic';
import { safeUrl } from '../lib/url';

const fc = await reader.singletons.freeCourse.read();
if (!fc) {
  throw new Error('Missing free-course content (src/content/free-course/index.yaml)');
}
const ty = fc.thank_you;
// safeUrl() collapses unsafe/invalid values to '#', which is truthy, so guard
// against it explicitly to keep the LinkedIn fallback meaningful.
const safeCta = safeUrl(ty.cta_url);
const ctaUrl =
  safeCta && safeCta !== '#' ? safeCta : 'https://linkedin.com/in/lorraineklee';
const isExternal = /^https?:\/\//i.test(ctaUrl);

// Partnerships is the page's primary action. Nearly every tap from this page
// used to go to LinkedIn, which is the least valuable of the two outcomes, so
// the speaking enquiry now leads and LinkedIn sits under it as an outline
// button.
const partnerUrl = (() => {
  const safe = safeUrl(ty.partnerships_cta_url);
  return safe && safe !== '#' ? safe : '/contact';
})();
const partnerEmail = ty.partnerships_email;
---

<FunnelLayout
  title={fc.thankyou_seo_title || "You're in | From Invisible to Influential"}
  description={fc.thankyou_seo_description ||
    'Thanks for signing up for the free 5-day course. Day 1 is on its way to your inbox.'}
>
  {/* GA4 key event (CLI-51): this page is where Kit redirects after a
      successful free-course signup, so its load is the reliable conversion
      signal. Fired via GoogleAnalytics.astro's [data-ga-event] tracker. */}
  <div hidden data-ga-event="free_course_signup" data-ga-on="load"></div>

  <section class="ty">
    <div class="grid12 ty-grid">
      <div class="ty-copy fade-up">
        <span class="eyebrow ty-eyebrow">{ty.eyebrow}</span>
        <p class="ty-intro">{ty.intro}</p>
        <h1 class="ty-headline">{ty.headline}</h1>
        <p class="ty-closing">{ty.closing}</p>
        {
          ty.partnerships_headline && (
            <div class="ty-partner">
              <h2 class="ty-partner-headline">{ty.partnerships_headline}</h2>
              {ty.partnerships_body && <p class="ty-partner-body">{ty.partnerships_body}</p>}
              <a class="btn primary large ty-cta" href={partnerUrl}>
                {ty.partnerships_cta_label || "Contact Lorraine's team"}{' '}
                <span aria-hidden="true">&rarr;</span>
              </a>
              {partnerEmail && (
                <p class="ty-partner-email">
                  Or reach out to <a href={`mailto:${partnerEmail}`}>{partnerEmail}</a>
                </p>
              )}
            </div>
          )
        }
        {
          ty.cta_label && (
            <a
              class="btn outline ty-linkedin"
              href={ctaUrl}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >
              {ty.cta_label}
            </a>
          )
        }
      </div>
      {
        ty.image && (
          <div class="ty-media fade-up" style="animation-delay: 80ms;">
            <img class="ty-img" src={ty.image} alt={ty.image_alt} decoding="async" />
          </div>
        )
      }
    </div>
  </section>

  {/* Permanently suppress the site-wide free-course popup (CLI-146): reaching
      this page means a successful signup from any entry point (funnel forms,
      /subscribe, or the popup itself), so the popup should never show again. */}
  <script is:inline>
    try {
      window.localStorage.setItem('ll:free-course-popup:subscribed', '1');
    } catch (e) {
      /* private mode / storage disabled — nothing to persist */
    }
  </script>
</FunnelLayout>

<style>
  .ty {
    padding: clamp(48px, 7vw, 96px) 0 clamp(40px, 6vw, 80px);
  }
  .ty-grid {
    align-items: center;
    row-gap: 40px;
  }
  .ty-copy {
    grid-column: 1 / span 7;
  }
  .ty-media {
    grid-column: 8 / span 5;
  }
  .ty-eyebrow {
    color: var(--accent);
  }
  .ty-intro {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 28px);
    color: var(--ink-700);
    margin: 14px 0 18px;
  }
  .ty-headline {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink-900);
    margin: 0 0 24px;
    text-wrap: balance;
  }
  .ty-closing {
    font-family: var(--font-sans);
    font-size: clamp(16px, 1.2vw, 18px);
    color: var(--ink-700);
    margin: 0 0 28px;
  }
  /* Partnerships block: the primary action on this page. */
  .ty-partner {
    margin: 0 0 24px;
    padding: 28px;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-2xl);
    background: var(--surface-alt, #fff);
  }
  .ty-partner-headline {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--ink-900);
    margin: 0 0 12px;
    text-wrap: balance;
  }
  .ty-partner-body {
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.6;
    color: var(--ink-700);
    margin: 0 0 20px;
  }
  .ty-partner-email {
    font-family: var(--font-sans);
    font-size: 14px;
    color: var(--ink-500);
    margin: 14px 0 0;
  }
  .ty-partner-email a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ty-partner-email a:hover {
    color: var(--accent);
  }
  /* LinkedIn sits below the partnerships block and reads as the quieter
     option, so the two never compete for the same tap. */
  .ty-linkedin {
    display: inline-flex;
  }
  .ty-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
  }
  @media (max-width: 900px) {
    .ty-copy {
      grid-column: 1 / -1;
      order: 2;
    }
    .ty-media {
      grid-column: 1 / -1;
      order: 1;
      max-width: 420px;
      margin: 0 auto;
    }
  }
</style>
