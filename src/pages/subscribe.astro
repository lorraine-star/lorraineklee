---
/*
 * /subscribe/ — the standalone weekly-newsletter signup page (CLI-122).
 *
 * Canonical newsletter destination; preserved as-is from the WordPress URL.
 * Copy is editable in Keystatic (src/content/subscribe/index.yaml). The
 * Kit/ConvertKit form ID lives in that singleton (`kit_form_id`): when set, we
 * reuse the shared FreeCourseForm island (same POST-to-Kit mechanics as the
 * free-course funnel). When empty, we render a clearly-labeled placeholder so
 * the page is live and on-brand while the production form ID is confirmed.
 *
 * This is intentionally a separate, general newsletter signup. It is NOT the
 * "From Invisible to Influential" free-course funnel (CLI-117), which uses its
 * own hard-wired Kit forms.
 */
import SpeakingLayout from '../layouts/SpeakingLayout.astro';
import FreeCourseForm from '../components/FreeCourseForm.astro';
import { reader } from '../lib/keystatic';
import { safeUrl } from '../lib/url';

const page = await reader.singletons.subscribe.read();
if (!page) {
  throw new Error('Missing subscribe content (src/content/subscribe/index.yaml)');
}

const {
  eyebrow,
  headline,
  headline_accent,
  lead,
  intro,
  benefits_heading,
  benefits,
  byline,
  hero_image,
  hero_image_alt,
  testimonials_eyebrow,
  testimonials_heading,
  testimonials,
  kit_form_id,
  form_button_label,
  name_placeholder,
  email_placeholder,
  fineprint,
} = page;

const formId = kit_form_id?.trim() ?? '';
const items = (benefits ?? []).filter((b) => b && b.trim());

// The byline is plain text with markdown links so it can stay in .yaml and
// carry more than one link; see the note in keystatic.config.ts. Only links
// and single-asterisk emphasis are supported, which is all this line needs,
// and the text is still rendered as text so nothing here can inject markup.
type BylinePart =
  | { kind: 'text'; text: string; em: boolean }
  | { kind: 'link'; text: string; href: string; em: boolean };

function parseByline(src: string): BylinePart[] {
  const parts: BylinePart[] = [];
  // [label](url) or *emphasis*, where a label may itself be wrapped in *.
  const token = /\*?\[([^\]]+)\]\(([^)]+)\)\*?|\*([^*]+)\*/g;
  let last = 0;
  for (let m = token.exec(src); m; m = token.exec(src)) {
    if (m.index > last) {
      parts.push({ kind: 'text', text: src.slice(last, m.index), em: false });
    }
    if (m[1] !== undefined) {
      const href = safeUrl(m[2]);
      const em = m[0].startsWith('*');
      parts.push(
        href && href !== '#'
          ? { kind: 'link', text: m[1], href, em }
          : { kind: 'text', text: m[1], em }
      );
    } else {
      parts.push({ kind: 'text', text: m[3], em: true });
    }
    last = m.index + m[0].length;
  }
  if (last < src.length) {
    parts.push({ kind: 'text', text: src.slice(last), em: false });
  }
  return parts;
}

const bylineText = byline?.trim() ?? '';
const bylineParts = bylineText ? parseByline(bylineText) : [];
const hasByline = bylineParts.length > 0;

const cardImage = hero_image?.trim() ?? '';

// The quotes are reader-supplied, so the whole section stays hidden until
// there is at least one rather than rendering an empty heading.
const quotes = (testimonials ?? []).filter((t) => t?.quote && t.quote.trim());
---

<SpeakingLayout
  title={page.seo_title || "Subscribe | Lorraine K. Lee"}
  description={page.seo_description || lead}
  activeId="learn"
>
  <section class="section section--tight">
    <div class="grid12">
      <div class="sub-grid">
        {/* ---------- Left: copy + benefits ---------- */}
        <aside class="sub-copy fade-up">
          <div class="page-hero-eyebrow">
            <span class="dot"></span>
            <span class="eyebrow" style="color: var(--ink-500);">{eyebrow}</span>
          </div>
          <h1>{headline} <em>{headline_accent}</em></h1>
          <p class="sub-lead">{lead}</p>
          {intro && <p class="sub-intro">{intro}</p>}

          {
            items.length > 0 && (
              <>
                {benefits_heading && (
                  <h2 class="sub-benefits-heading">{benefits_heading}</h2>
                )}
              <ul class="sub-benefits">
                {items.map((b) => (
                  <li>
                    <span class="sub-check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                    </span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>
              </>
            )
          }

          {
            hasByline && (
              <p class="sub-byline">
                {bylineParts.map((part) =>
                  part.kind === 'link' ? (
                    <a href={part.href} target="_blank" rel="noopener noreferrer">{part.em ? <em>{part.text}</em> : part.text}</a>
                  ) : part.em ? (
                    <em>{part.text}</em>
                  ) : (
                    part.text
                  )
                )}
              </p>
            )
          }
        </aside>

        {/* ---------- Right: signup form ---------- */}
        <div class="sub-form-card fade-up" style="animation-delay: 120ms;">
          {
            cardImage && (
              <img
                class="sub-card-img"
                src={cardImage}
                alt={hero_image_alt || ''}
                loading="eager"
                decoding="async"
              />
            )
          }
          <div class="sub-form-body">
          {
            formId ? (
              <>
                <FreeCourseForm
                  formId={formId}
                  idPrefix="sub"
                  buttonLabel={form_button_label || 'Subscribe'}
                  namePlaceholder={name_placeholder || 'First Name'}
                  emailPlaceholder={email_placeholder || 'Enter your best email'}
                  event="newsletter_signup"
                />
                {fineprint && <p class="sub-fineprint">{fineprint}</p>}
              </>
            ) : (
              /* TODO (CLI-122): set `kit_form_id` in src/content/subscribe/index.yaml
                 to the production Kit/ConvertKit newsletter form ID. Until then
                 this placeholder keeps the route live without capturing emails. */
              <div class="sub-placeholder" data-subscribe-placeholder>
                <span class="sub-placeholder-label">Newsletter signup</span>
                <p class="sub-placeholder-copy">
                  The signup form is being connected. Check back shortly to join
                  the weekly newsletter.
                </p>
              </div>
            )
          }
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    quotes.length > 0 && (
      <section class="section section--tight sub-quotes-section">
        <div class="grid12">
          <div class="sub-quotes-head">
            {testimonials_eyebrow && (
              <span class="eyebrow">{testimonials_eyebrow}</span>
            )}
            {testimonials_heading && <h2>{testimonials_heading}</h2>}
          </div>
          <div class="sub-quotes reveal-stagger">
            {quotes.map((t) => (
              <figure class="sub-quote">
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <span class="sub-quote-author">{t.author}</span>
                  {t.roleOrCompany && (
                    <span class="sub-quote-role">{t.roleOrCompany}</span>
                  )}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }
</SpeakingLayout>

<style>
  /* ================================================================
     Subscribe — slim newsletter signup. Primitives (section, grid12,
     page-hero-eyebrow, eyebrow, fade-up) come from styles/editorial/.
     ================================================================ */
  .sub-grid {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }
  .sub-copy h1 {
    margin: 14px 0 0;
  }
  /* This is the subhead carrying the whole offer, so it is the darkest and
     largest of the three text blocks. It was the lightest, which left the page
     getting darker as it went down and the least important line shouting
     loudest. */
  .sub-lead {
    margin: 18px 0 0;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.55;
    color: var(--ink-900);
    max-width: 52ch;
  }
  .sub-benefits {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sub-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.45;
    color: var(--ink-900);
  }
  .sub-check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--white, #fff);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .sub-check svg {
    width: 14px;
    height: 14px;
  }

  /* ---- Form card ---- */
  .sub-form-card {
    background: var(--white, #fff);
    border: 1px solid var(--border-soft);
    border-radius: 18px;
    box-shadow: var(--shadow-md);
    /* The photo runs to the card's edges, so the card clips it to the rounded
       corners and the padding lives on the inner body instead. */
    overflow: hidden;
  }
  .sub-form-body {
    padding: clamp(22px, 2.6vw, 32px);
  }
  /* Natural height rather than a fixed band: the photo runs from her face
     down to the stack of books, and any crop tight enough to be a banner
     loses one end or the other. */
  .sub-card-img {
    display: block;
    width: 100%;
    height: auto;
  }
  .sub-form-card :global(.fc-form) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
  }
  .sub-form-card :global(.fc-field) {
    display: flex;
  }
  .sub-form-card :global(.fc-input) {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--ink-900);
    background: var(--paper-deep, #f9f9f9);
    border: 1px solid var(--ink-200);
    border-radius: 10px;
    padding: 14px 15px;
    transition: box-shadow 160ms ease, border-color 160ms ease;
  }
  .sub-form-card :global(.fc-input:focus-visible) {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(8, 74, 243, 0.18);
  }
  .sub-form-card :global(.fc-submit) {
    justify-content: center;
    width: 100%;
  }
  .sub-fineprint {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: 12.5px;
    color: var(--ink-300);
    text-align: center;
  }

  /* ---- Placeholder (no form ID yet) ---- */
  .sub-placeholder {
    border: 1px dashed var(--ink-200);
    border-radius: 12px;
    padding: 28px 24px;
    text-align: center;
    background: var(--paper-deep, #f9f9f9);
  }
  .sub-placeholder-label {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .sub-placeholder-copy {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-500);
  }

  .sub-intro {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: clamp(15px, 1.15vw, 16.5px);
    line-height: 1.65;
    color: var(--ink-700);
    max-width: 56ch;
  }
  .sub-benefits-heading {
    margin: 28px 0 0;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-500);
  }
  /* Credibility line, set smaller than the body copy so it supports the offer
     without competing with it. */
  .sub-byline {
    margin: 26px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--border-soft);
    font-family: var(--font-sans);
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--ink-500);
    max-width: 56ch;
  }
  .sub-byline a {
    color: var(--ink-900);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sub-byline a:hover {
    color: var(--accent);
  }

  /* ---- Reader quotes ---- */
  .sub-quotes-section {
    padding-top: 0;
  }
  .sub-quotes-head {
    grid-column: 1 / -1;
    text-align: center;
    margin-bottom: 28px;
  }
  .sub-quotes-head h2 {
    margin: 10px 0 0;
  }
  .sub-quotes {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
  }
  .sub-quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    background: var(--white, #fff);
    border: 1px solid var(--border-soft);
    border-radius: 18px;
    padding: clamp(22px, 2.4vw, 28px);
    box-shadow: var(--shadow-sm);
  }
  .sub-quote blockquote {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-900);
  }
  /* Quote marks are decorative, so they are drawn in CSS rather than typed
     into the content, which keeps them out of the copy editors maintain. */
  .sub-quote blockquote::before {
    content: '\201C';
  }
  .sub-quote blockquote::after {
    content: '\201D';
  }
  .sub-quote figcaption {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--font-sans);
  }
  .sub-quote-author {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink-900);
  }
  .sub-quote-role {
    font-size: 13px;
    color: var(--ink-500);
  }

  /* ---- Responsive ---- */
  @media (max-width: 980px) {
    .sub-quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 820px) {
    .sub-grid {
      grid-template-columns: 1fr;
    }
    .sub-quotes {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
