---
import SpeakingLayout from '../layouts/SpeakingLayout.astro';
import { reader } from '../lib/keystatic';
import { safeUrl } from '../lib/url';

const page = await reader.singletons.interviewsPage.read();
if (!page) {
	throw new Error(
		'Missing interviews page content (src/content/interviews-page/index.yaml)'
	);
}
const {
	hero,
	guest_section,
	podcast_section,
	guest_appearances,
	final_cta,
} = page;

// Small reusable UI microcopy (editable via Keystatic, with literal fallbacks).
const labels = page.labels ?? {};
const browseInterviewsLabel = labels.browse_interviews || 'Browse interviews';
const watchHereLabel = labels.watch_here || 'Watch it here';

const heroCtaUrl = safeUrl(hero.cta_url, '/learn#course');
const finalCtaUrl = safeUrl(final_cta.cta_url, '/learn#course');
const isExternal = (url: string) => /^https?:\/\//i.test(url);

const watchUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const thumbUrl = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

// "More on YouTube" button under the guest grid (editable via Keystatic).
const youtubeCtaUrl = safeUrl(guest_section.youtube_cta_url);
const youtubeCtaLabel = (guest_section.youtube_cta_label ?? '').trim();

// Spotify "Guest Podcast Interviews" playlist embed (editable via Keystatic).
const spotifyId = (podcast_section?.spotify_playlist_id ?? '').trim();
const spotifyEmbedUrl = spotifyId
	? `https://open.spotify.com/embed/playlist/${spotifyId}?utm_source=generator`
	: '';

// Guest appearances: keep only items that resolve to a real link.
const guests = (guest_appearances ?? [])
	.map((g) => {
		const id = (g.youtube_id ?? '').trim();
		const href = id ? watchUrl(id) : safeUrl(g.url);
		return { ...g, id, href };
	})
	.filter((g) => g.href);
---

<SpeakingLayout
	title={page.seo_title || "Guest Interviews | Lorraine K. Lee"}
	description={page.seo_description || hero.lead}
	activeId="thought-leadership"
>
	{/* ---------- Hero ---------- */}
	<section class="page-hero page-hero--center">
		<div class="grid12 page-hero-grid">
			<div class="page-hero-copy fade-up">
				<div class="page-hero-eyebrow">
					<span class="dot"></span>
					<span class="eyebrow" style="color: var(--ink-500);">{hero.eyebrow}</span>
				</div>
				<h1>{hero.headline} <em>{hero.headline_accent}</em></h1>
				<p class="lead-large">{hero.lead}</p>
				{
					hero.cta_label && (
						<div class="hero-cta-row">
							<a
								class="btn primary large"
								href={heroCtaUrl}
								target={isExternal(heroCtaUrl) ? '_blank' : undefined}
								rel={isExternal(heroCtaUrl) ? 'noopener noreferrer' : undefined}
							>
								{hero.cta_label} <span aria-hidden="true">&rarr;</span>
							</a>
							<a class="anchor-link" href="#guest-interviews">
								{browseInterviewsLabel}{' '}
								<span class="arrow" aria-hidden="true">&rarr;</span>
							</a>
						</div>
					)
				}
			</div>
		</div>
	</section>

	{/* ---------- Guest appearances (Lorraine as guest) ---------- */}
	{
		guests.length > 0 && (
			<section class="section section--compact section--cream anchor-target" id="guest-interviews">
				<div class="grid12">
					<div class="section-head section-head--center">
						<span class="eyebrow">{guest_section.eyebrow}</span>
						<h2>
							{guest_section.heading} <em>{guest_section.heading_accent}</em>
						</h2>
						{guest_section.lead && <p class="lead">{guest_section.lead}</p>}
					</div>
					<div class="interview-cards reveal-stagger">
						{guests.map((g) => (
							<a
								class="interview-card"
								href={g.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<div class="interview-thumb">
									{g.id ? (
										<img
											src={thumbUrl(g.id)}
											alt=""
											loading="lazy"
											width="480"
											height="360"
										/>
									) : (
										<div class="interview-thumb-deco" aria-hidden="true" />
									)}
									<span class="play" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="currentColor">
											<path d="M8 5v14l11-7z" />
										</svg>
									</span>
								</div>
								<div class="interview-card-body">
									{g.show && <span class="interview-show">{g.show}</span>}
									<h3>{g.title}</h3>
									{g.description && (
										<p class="interview-desc">{g.description}</p>
									)}
									<span class="interview-link">
										{watchHereLabel} <span aria-hidden="true">&#8599;</span>
									</span>
								</div>
							</a>
						))}
					</div>
					{youtubeCtaLabel && youtubeCtaUrl && (
						<div class="guest-youtube-cta">
							<a
								class="btn outline"
								href={youtubeCtaUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								{youtubeCtaLabel} <span aria-hidden="true">&#8599;</span>
							</a>
						</div>
					)}
				</div>
			</section>
		)
	}

	{/* ---------- Podcast (Spotify playlist) ---------- */}
	{
		spotifyEmbedUrl && (
			<section class="section section--compact anchor-target" id="podcast-interviews">
				<div class="grid12">
					<div class="section-head section-head--center">
						<span class="eyebrow">{podcast_section.eyebrow}</span>
						<h2>
							{podcast_section.heading} <em>{podcast_section.heading_accent}</em>
						</h2>
						{podcast_section.lead && <p class="lead">{podcast_section.lead}</p>}
					</div>
					<div class="podcast-embed">
						<iframe
							src={spotifyEmbedUrl}
							title="Lorraine K. Lee Guest Podcast Interviews on Spotify"
							width="100%"
							height="420"
							loading="lazy"
							style="border:0;border-radius:12px;"
							allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
							allowfullscreen
						/>
					</div>
				</div>
			</section>
		)
	}

	{/* ---------- Final CTA ---------- */}
	<section class="section">
		<div class="grid12">
			<div class="final-cta">
				<div class="final-cta-inner">
					<span class="eyebrow">{final_cta.eyebrow}</span>
					<h2>
						{final_cta.heading} <em>{final_cta.heading_accent}</em>
					</h2>
					<p>{final_cta.body}</p>
					<a class="btn yellow large" href={finalCtaUrl}>
						{final_cta.cta_label} <span aria-hidden="true">&rarr;</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</SpeakingLayout>

<style>
	/* Guest-appearance cards: lightweight thumbnail links (no embedded iframes).
	   Must span the full 12-col .grid12 track; without grid-column the grid
	   collapses to a single auto column (CLI-85). */
	.interview-cards {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	/* "More on YouTube" button under the guest grid. */
	.guest-youtube-cta {
		grid-column: 1 / -1;
		display: flex;
		justify-content: center;
		margin-top: 40px;
	}
	/* Spotify "Guest Podcast Interviews" playlist embed. */
	.podcast-embed {
		grid-column: 1 / -1;
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
	}
	.podcast-embed iframe {
		display: block;
		width: 100%;
	}
	.interview-card {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1px solid var(--border-soft);
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.interview-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 26px 56px -40px rgba(73, 75, 81, 0.5);
	}
	.interview-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--ink-900);
		overflow: hidden;
	}
	.interview-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.interview-thumb-deco {
		position: absolute;
		inset: 0;
		background: var(--brand-gradient);
	}
	.interview-thumb .play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(73, 75, 81, 0.72);
		color: #fff;
		transition: background 0.25s ease, transform 0.25s ease;
	}
	.interview-thumb .play svg {
		width: 22px;
		height: 22px;
		margin-left: 2px;
	}
	.interview-card:hover .interview-thumb .play {
		background: var(--accent);
		transform: translate(-50%, -50%) scale(1.06);
	}
	.interview-card-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 20px 22px;
		flex: 1;
	}
	.interview-show {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-500);
	}
	.interview-card-body h3 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 19px;
		line-height: 1.25;
		color: var(--ink-900);
		margin: 0;
		flex: 1;
	}
	.interview-desc {
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--ink-700);
		margin: 0;
	}
	.interview-link {
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		color: var(--accent);
	}
	@media (max-width: 900px) {
		.interview-cards {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 560px) {
		.interview-cards {
			grid-template-columns: 1fr;
		}
	}
</style>
