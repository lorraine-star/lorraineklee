<script is:inline>

(function () {
  // Buy links: replace href="#" with the checkout URL before launch.
  document.querySelectorAll('[data-buy]').forEach(function (a) {
    a.addEventListener('click', function (e) { if (a.getAttribute('href') === '#checkout-pending') e.preventDefault(); });
  });

  // Sticky bar shows once the hero has scrolled away and hides near the decision block and final CTA.
  var bar = document.getElementById('sticky');
  var hero = document.getElementById('top');
  var hide = [document.getElementById('two-ways'), document.getElementById('start')];
  var state = { hero: true, hide: 0 };
  function update() { bar.classList.toggle('show', !state.hero && state.hide === 0); }
  if ('IntersectionObserver' in window) {
    new IntersectionObserver(function (es) { state.hero = es[0].isIntersecting; update(); }).observe(hero);
    hide.forEach(function (el) {
      new IntersectionObserver(function (es) {
        state.hide += es[0].isIntersecting ? 1 : -1;
        if (state.hide < 0) state.hide = 0;
        update();
      }).observe(el);
    });
  }

  // Copy the intro note, with a select-text fallback.
  var btn = document.getElementById('copyBtn');
  var note = document.getElementById('noteText');
  function selectNote() {
    var r = document.createRange(); r.selectNodeContents(note);
    var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
  }
  btn.addEventListener('click', function () {
    var done = function (msg) { btn.textContent = msg; setTimeout(function () { btn.textContent = 'Copy the intro note'; }, 2200); };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(note.innerText).then(function () { done('Copied!'); }, function () { selectNote(); done('Press Cmd/Ctrl+C'); });
    } else { selectNote(); done('Press Cmd/Ctrl+C'); }
  });

})();

</script>
