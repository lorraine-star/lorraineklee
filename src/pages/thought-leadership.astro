---
import SpeakingLayout from '../layouts/SpeakingLayout.astro';
import { reader } from '../lib/keystatic';
import { safeUrl } from '../lib/url';

const page = await reader.singletons.thoughtLeadership.read();
if (!page) {
	throw new Error(
		'Missing thought leadership content (src/content/thought-leadership/index.yaml)'
	);
}

const {
	hero,
	appearances_section,
	appearances,
	press_section,
	press_features,
	articles_section,
	authored_articles,
	interviews,
	final_cta,
} = page;

const isExternal = (url: string) => /^https?:\/\//i.test(url);

// Arrow glyph for a CTA button: on-site links get a forward arrow, links that
// leave the site get the "opens elsewhere" arrow. Pairs with the target/rel
// treatment applied to the same links.
const ctaArrow = (url: string) => (isExternal(url) ? '↗' : '→');

const watchUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const thumbUrl = (id: string) => `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;

// `safeUrl` returns '#' for invalid/unsafe URLs (e.g. javascript:). Treat that
// as "no link" so empty/unsafe values are dropped by filters and fall through
// to `|| fallback` rather than rendering a dead `#` link.
const resolveUrl = (value: string | null | undefined) => {
	const url = safeUrl(value);
	return url && url !== '#' ? url : '';
};

// Media items (appearances + interviews): prefer the YouTube link, fall back to
// the free-text URL, and drop anything that does not resolve to a real link.
const toMedia = (items: typeof appearances) =>
	(items ?? [])
		.map((item) => {
			const id = (item.youtube_id ?? '').trim();
			const href = id ? watchUrl(id) : resolveUrl(item.url);
			// Prefer an uploaded cover image; fall back to the YouTube poster.
			const image = item.thumbnail || (id ? thumbUrl(id) : '');
			// Only honor the "logo" treatment for an uploaded image (YouTube
			// posters are always photos).
			const isLogo = Boolean(item.thumbnail) && item.thumbnail_fit === 'logo';
			return { ...item, id, href, image, isLogo };
		})
		.filter((item) => item.href);

// "Recent appearances" is ordered by hand in Keystatic, so the top three were
// whatever happened to be entered first, including a 2024 item. Sort newest
// first so the teaser is actually recent. Dates are free text ("May 2025"), so
// anything unparseable sorts last rather than throwing.
const MONTHS = ['january','february','march','april','may','june','july',
	'august','september','october','november','december'];
const dateRank = (d?: string | null): number => {
	const m = /^\s*([a-z]+)\s+(\d{4})/i.exec(d ?? '');
	if (!m) return -1;
	const month = MONTHS.indexOf(m[1].toLowerCase());
	return month < 0 ? -1 : Number(m[2]) * 12 + month;
};
const guestAppearances = toMedia(appearances).sort(
	(a, b) => dateRank(b.date) - dateRank(a.date)
);

const pressFeatures = (press_features ?? [])
	.map((f) => ({ ...f, href: resolveUrl(f.url) }))
	.filter((f) => f.href);
const articles = (authored_articles ?? [])
	.map((a) => ({ ...a, href: resolveUrl(a.url) }))
	.filter((a) => a.href);

const primaryCtaUrl = resolveUrl(hero.primary_cta_url) || '/contact';
const finalCtaUrl = resolveUrl(final_cta.cta_url) || '/contact';

const appearancesMore = resolveUrl(appearances_section.view_more_url);
const pressMore = resolveUrl(press_section.view_more_url);
const articlesMore = resolveUrl(articles_section.view_more_url);

// This page is an overview hub, not the canonical full inventory. The
// standalone pages (/articles/, /featured-in/, /interviews/) own the complete
// lists, so each embedded section shows only a short teaser. We slice the
// rendered arrays here (rather than trimming the Keystatic source) so the CMS
// data stays intact and editors can keep curating the full set.
const TEASER_COUNT = 3;
const appearancesTeaser = guestAppearances.slice(0, TEASER_COUNT);
const pressTeaser = pressFeatures.slice(0, TEASER_COUNT);
const articlesTeaser = articles.slice(0, TEASER_COUNT);
---

<SpeakingLayout
	title={page.seo_title || "Thought Leadership | Lorraine K. Lee"}
	description={page.seo_description || hero.lead}
	activeId="thought-leadership"
>
	{/* ---------- Hero ---------- */}
	<section class="page-hero page-hero--center" id="top">
		<div class="grid12 page-hero-grid">
			<div class="page-hero-copy fade-up">
				<div class="page-hero-eyebrow">
					<span class="dot"></span>
					<span class="eyebrow" style="color: var(--ink-500);">
						{hero.eyebrow}
					</span>
				</div>
				<h1>{hero.headline} <em>{hero.headline_accent}</em></h1>
				<p class="lead-large">{hero.lead}</p>
				<div class="hero-cta-row">
					<a
						class="btn primary large"
						href={primaryCtaUrl}
						target={isExternal(primaryCtaUrl) ? '_blank' : undefined}
						rel={isExternal(primaryCtaUrl) ? 'noopener noreferrer' : undefined}
					>
						{hero.primary_cta_label} <span aria-hidden="true">&rarr;</span>
					</a>
				</div>
			</div>
		</div>
	</section>

	{/* ---------- Section index ----------
	    The page runs to four near-identical card grids, so without this a
	    visitor has no idea what is below or how far it goes. */}
	<nav class="tl-index" aria-label="Sections on this page">
		<div class="grid12">
			<ul class="tl-index-list">
				{
					[
						/* Short fixed labels. The section headings are split into a
						   plain half and an italic half, so reusing either one gave
						   fragments like "appearances" and "interviewed". */
						{ id: 'appearances', label: 'Podcasts & shows', show: guestAppearances.length > 0 },
						{ id: 'press', label: 'Press & features', show: pressFeatures.length > 0 },
						{ id: 'articles', label: 'Articles', show: articles.length > 0 },
					]
						.filter((i) => i.show)
						.map((i) => (
							<li>
								<a href={`#${i.id}`}>{i.label}</a>
							</li>
						))
				}
			</ul>
		</div>
	</nav>

	{/* ---------- Guest appearances (Lorraine as guest) ---------- */}
	{
		guestAppearances.length > 0 && (
			<section class="section section--compact anchor-target" id="appearances">
				<div class="grid12">
					<div class="section-head section-head--center">
						<span class="eyebrow">{appearances_section.eyebrow}</span>
						<h2>
							{appearances_section.heading}{' '}
							<em>{appearances_section.heading_accent}</em>
						</h2>
						{appearances_section.lead && (
							<p class="lead">{appearances_section.lead}</p>
						)}
					</div>
					<div class="tl-media-cards reveal-stagger">
						{appearancesTeaser.map((g) => (
							<a
								class="tl-media-card"
								href={g.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								{/* The play badge only belongs on something playable. An item
								    with no cover and no video, such as a LinkedIn post, used to
								    render an empty grey box with a play button on it, which read
								    as a broken video. */}
								{(g.image || g.id) && (
									<div class:list={['tl-media-thumb', { 'tl-media-thumb--logo': g.isLogo }]}>
										{g.image ? (
											<img
												src={g.image}
												alt=""
												loading="lazy"
												width="480"
												height="360"
											/>
										) : (
											<div class="tl-media-thumb-deco" aria-hidden="true" />
										)}
										{g.id && (
											<span class="tl-media-play" aria-hidden="true">
												<svg viewBox="0 0 24 24" fill="currentColor">
													<path d="M8 5v14l11-7z" />
												</svg>
											</span>
										)}
									</div>
								)}
								<div class="tl-media-body">
									<span class="tl-media-meta">
										{g.show}
										{g.show && g.date ? ' · ' : ''}
										{g.date}
									</span>
									<h3>{g.title}</h3>
									{g.description && (
										<p class="tl-media-desc">{g.description}</p>
									)}
									<span class="tl-media-link">
										{g.cta_label || 'Watch now'}{' '}
										<span aria-hidden="true">&#8599;</span>
									</span>
								</div>
							</a>
						))}
					</div>
					{appearancesMore && appearances_section.view_more_label && (
						<div class="tl-view-more">
							<a
								class="btn outline"
								href={appearancesMore}
								target={isExternal(appearancesMore) ? '_blank' : undefined}
								rel={
									isExternal(appearancesMore)
										? 'noopener noreferrer'
										: undefined
								}
							>
								{appearances_section.view_more_label}{' '}
								<span aria-hidden="true">{ctaArrow(appearancesMore)}</span>
							</a>
						</div>
					)}
					<div class="tl-back-to-top">
						<a href="#top">
							<span aria-hidden="true">&uarr;</span> Back to top
						</a>
					</div>
				</div>
			</section>
		)
	}

	{/* ---------- Featured In (press teaser) ---------- */}
	{
		pressFeatures.length > 0 && (
			<section class="section section--compact section--cream anchor-target" id="press">
				<div class="grid12">
					<div class="section-head section-head--center">
						<span class="eyebrow">{press_section.eyebrow}</span>
						<h2>
							{press_section.heading}{' '}
							<em>{press_section.heading_accent}</em>
						</h2>
						{press_section.lead && <p class="lead">{press_section.lead}</p>}
					</div>
					<div class="tl-link-cards reveal-stagger">
						{pressTeaser.map((f) => (
							<a
								class="tl-link-card"
								href={f.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								{f.outlet && <span class="tl-link-outlet">{f.outlet}</span>}
								<h3>{f.title}</h3>
								<span class="tl-link-cta">
									{f.cta_label || 'Read more'}{' '}
									<span aria-hidden="true">&#8599;</span>
								</span>
							</a>
						))}
					</div>
					{pressMore && press_section.view_more_label && (
						<div class="tl-view-more">
							<a
								class="btn outline"
								href={pressMore}
								target={isExternal(pressMore) ? '_blank' : undefined}
								rel={isExternal(pressMore) ? 'noopener noreferrer' : undefined}
							>
								{press_section.view_more_label}{' '}
								<span aria-hidden="true">{ctaArrow(pressMore)}</span>
							</a>
						</div>
					)}
					<div class="tl-back-to-top">
						<a href="#top">
							<span aria-hidden="true">&uarr;</span> Back to top
						</a>
					</div>
				</div>
			</section>
		)
	}

	{/* ---------- Authored articles ---------- */}
	{
		articles.length > 0 && (
			<section class="section section--compact anchor-target" id="articles">
				<div class="grid12">
					<div class="section-head section-head--center">
						<span class="eyebrow">{articles_section.eyebrow}</span>
						<h2>
							{articles_section.heading}{' '}
							<em>{articles_section.heading_accent}</em>
						</h2>
						{articles_section.lead && (
							<p class="lead">{articles_section.lead}</p>
						)}
					</div>
					<div class="tl-link-cards reveal-stagger">
						{articlesTeaser.map((a) => (
							<a
								class="tl-link-card"
								href={a.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<span class="tl-link-outlet">
									{a.outlet}
									{a.outlet && a.date ? ' · ' : ''}
									{a.date}
								</span>
								<h3>{a.title}</h3>
								<span class="tl-link-cta">
									{a.cta_label || 'Read more'}{' '}
									<span aria-hidden="true">&#8599;</span>
								</span>
							</a>
						))}
					</div>
					{articlesMore && articles_section.view_more_label && (
						<div class="tl-view-more">
							<a
								class="btn outline"
								href={articlesMore}
								target={isExternal(articlesMore) ? '_blank' : undefined}
								rel={
									isExternal(articlesMore) ? 'noopener noreferrer' : undefined
								}
							>
								{articles_section.view_more_label}{' '}
								<span aria-hidden="true">{ctaArrow(articlesMore)}</span>
							</a>
						</div>
					)}
					<div class="tl-back-to-top">
						<a href="#top">
							<span aria-hidden="true">&uarr;</span> Back to top
						</a>
					</div>
				</div>
			</section>
		)
	}

	{/* ---------- Final CTA ---------- */}
	<section class="section">
		<div class="grid12">
			<div class="final-cta">
				<div class="final-cta-inner">
					<span class="eyebrow">{final_cta.eyebrow}</span>
					<h2>
						{final_cta.heading} <em>{final_cta.heading_accent}</em>
					</h2>
					<p>{final_cta.body}</p>
					<a
						class="btn yellow large"
						href={finalCtaUrl}
						target={isExternal(finalCtaUrl) ? '_blank' : undefined}
						rel={isExternal(finalCtaUrl) ? 'noopener noreferrer' : undefined}
					>
						{final_cta.cta_label} <span aria-hidden="true">&rarr;</span>
					</a>
				</div>
			</div>
		</div>
	</section>
</SpeakingLayout>

<style>
	.tl-view-more {
		/* Span the full grid like the card rows above it. Without this the row
		   lands in a single 12-column track (~166px on a phone) and squeezes
		   the CTA into a narrow, off-center column. */
		grid-column: 1 / -1;
		display: flex;
		justify-content: center;
		margin-top: clamp(20px, 2.5vw, 32px);
	}

	/* Every per-section "view all" CTA uses the site's secondary button
	   (.btn.outline), the same treatment the section-footer CTAs on /articles,
	   /interviews, and /speaking already use, so the look comes from base.css.
	   The one override: these labels are editable in Keystatic, and .btn is
	   nowrap by default, so let a long label wrap instead of pushing the page
	   sideways on a narrow phone. */
	.tl-view-more .btn {
		max-width: 100%;
		white-space: normal;
		text-align: center;
	}

	/* Media cards — lightweight YouTube/link thumbnails for appearances and
	   interviews Lorraine has conducted. */
	.tl-media-cards {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
		gap: clamp(16px, 2vw, 24px);
		margin-top: clamp(20px, 2.5vw, 32px);
	}
	.tl-media-card {
		display: flex;
		flex-direction: column;
		background: var(--bg-card, #fff);
		border: 1px solid var(--border-soft);
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.tl-media-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 26px 56px -40px rgba(73, 75, 81, 0.5);
	}
	.tl-media-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--ink-900);
		overflow: hidden;
	}
	.tl-media-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	/* Logo treatment: center a (usually transparent) brand mark on a light
	   background instead of cropping it like a photo. */
	.tl-media-thumb--logo {
		background: var(--paper-deep, #ebebeb);
	}
	.tl-media-thumb--logo img {
		object-fit: contain;
		padding: clamp(24px, 6%, 48px);
	}
	.tl-media-thumb-deco {
		position: absolute;
		inset: 0;
		background: linear-gradient(135deg, var(--ink-900), #2e3033);
	}
	.tl-media-play {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(73, 75, 81, 0.72);
		color: #fff;
		transition: background 0.25s ease, transform 0.25s ease;
	}
	.tl-media-play svg {
		width: 22px;
		height: 22px;
		margin-left: 2px;
	}
	.tl-media-card:hover .tl-media-play {
		background: var(--accent);
		transform: translate(-50%, -50%) scale(1.06);
	}
	.tl-media-body {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 18px 20px 22px;
		flex: 1;
	}
	.tl-media-meta {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--ink-500);
	}
	.tl-media-body h3 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: 19px;
		line-height: 1.25;
		color: var(--ink-900);
		margin: 0;
	}
	.tl-media-desc {
		font-family: var(--font-sans);
		font-size: 14.5px;
		line-height: 1.55;
		color: var(--ink-700);
		margin: 0;
		flex: 1;
	}
	/* In-card CTA pill (see the shared rule further down, next to
	   .tl-link-cta). */
	.tl-media-link {
		margin-top: auto;
	}

	/* Link cards — text-only press features and authored articles. */
	.tl-link-cards {
		grid-column: 1 / -1;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
		gap: clamp(16px, 2vw, 24px);
		margin-top: clamp(20px, 2.5vw, 32px);
	}
	.tl-link-card {
		display: flex;
		flex-direction: column;
		gap: 10px;
		background: var(--bg-card, #fff);
		border: 1px solid var(--border-soft);
		border-radius: var(--radius-2xl, 20px);
		padding: clamp(22px, 2.6vw, 30px);
		text-decoration: none;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}
	.tl-link-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 26px 56px -40px rgba(73, 75, 81, 0.5);
	}
	.tl-link-outlet {
		font-family: var(--font-sans);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		color: var(--accent);
	}
	.tl-link-card h3 {
		font-family: var(--font-serif);
		font-weight: 500;
		font-size: clamp(18px, 2vw, 21px);
		line-height: 1.3;
		color: var(--ink-900);
		margin: 0;
		flex: 1;
	}
	.tl-link-cta {
		margin-top: 8px;
	}

	/* Card CTAs ("Watch now", "Read more").

	   These stay <span>s on purpose: the whole card is already the <a>, so a
	   nested anchor here would be invalid HTML and would break the card-wide
	   click target. They are the visible affordance for that link, so they
	   carry the tertiary button look (.btn.ghost's outlined pill) and fill in
	   on card hover/focus to confirm the card is interactive. */
	.tl-media-link,
	.tl-link-cta {
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-sans);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--accent);
		background: transparent;
		border: 1.5px solid currentColor;
		border-radius: 999px;
		padding: 9px 18px;
		transition: background 240ms var(--ease-out), color 240ms var(--ease-out),
			border-color 240ms var(--ease-out);
	}
	.tl-media-card:hover .tl-media-link,
	.tl-media-card:focus-visible .tl-media-link,
	.tl-link-card:hover .tl-link-cta,
	.tl-link-card:focus-visible .tl-link-cta {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	/* Keyboard users get the same button feedback as mouse users: the card's
	   own focus ring plus the filled CTA above. */
	.tl-media-card:focus-visible,
	.tl-link-card:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.tl-media-link,
		.tl-link-cta {
			transition: none;
		}
	}

	/* Section index: a compact row under the hero so the shape of the page is
	   visible before scrolling through four near-identical card grids. */
	.tl-index {
		padding: 0 0 clamp(8px, 1.6vw, 20px);
	}
	.tl-index-list {
		grid-column: 1 / -1;
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 10px 12px;
	}
	.tl-index-list a {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 13.5px;
		line-height: 1;
		color: var(--ink-700);
		background: #fff;
		border: 1px solid var(--border-soft);
		border-radius: var(--radius-pill);
		padding: 10px 16px;
		text-decoration: none;
		transition: background 160ms var(--ease-out), color 160ms var(--ease-out),
			border-color 160ms var(--ease-out);
	}
	.tl-index-list a:hover,
	.tl-index-list a:focus-visible {
		background: var(--ink-900);
		border-color: var(--ink-900);
		color: #fff;
	}
	.tl-back-to-top {
		/* It sits inside .grid12, so without this it takes a single column and
		   the label wraps onto two lines against the left edge. */
		grid-column: 1 / -1;
		margin-top: clamp(20px, 2.4vw, 30px);
		text-align: center;
	}
	.tl-back-to-top a {
		font-family: var(--font-sans);
		font-size: 13px;
		color: var(--ink-500);
		text-decoration: none;
	}
	.tl-back-to-top a:hover {
		color: var(--accent);
	}
</style>
